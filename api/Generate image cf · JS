// Proxy tạo ảnh miễn phí bằng Cloudflare Workers AI (model FLUX.1 [schnell]) — thay thế cho Pollinations,
// chất lượng tốt hơn và cho phép tạo nhiều ảnh song song cùng lúc (vì đây là hạn mức riêng của tài khoản bạn,
// không bị giới hạn dùng chung như Pollinations ẩn danh).
// Cần 2 biến môi trường trên Vercel: CLOUDFLARE_ACCOUNT_ID và CLOUDFLARE_API_TOKEN (xem README để lấy 2 giá trị này).
const CF_IMAGE_MODEL = process.env.CLOUDFLARE_IMAGE_MODEL || '@cf/black-forest-labs/flux-1-schnell';

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    res.status(405).json({ error: { message: 'Chỉ hỗ trợ POST' } });
    return;
  }
  // .trim() phòng trường hợp giá trị dán vào Vercel bị dính khoảng trắng/xuống dòng thừa (lỗi copy-paste rất hay gặp,
  // và Cloudflare sẽ trả về lỗi khó hiểu như "404" thay vì báo rõ sai định dạng nếu URL bị dính ký tự thừa).
  const accountId = (process.env.CLOUDFLARE_ACCOUNT_ID || '').trim();
  const apiToken = (process.env.CLOUDFLARE_API_TOKEN || '').trim();
  if (!accountId || !apiToken) {
    res.status(400).json({ error: { message: 'Thiếu cấu hình Cloudflare: chưa có biến môi trường CLOUDFLARE_ACCOUNT_ID và/hoặc CLOUDFLARE_API_TOKEN trên server (xem README để lấy 2 giá trị này từ dashboard Cloudflare, miễn phí).' } });
    return;
  }
  const prompt = req.body && req.body.prompt;
  if (!prompt || !String(prompt).trim()) {
    res.status(400).json({ error: { message: 'Thiếu nội dung prompt để tạo ảnh' } });
    return;
  }
  try {
    const upstream = await fetch(
      `https://api.cloudflare.com/client/v4/accounts/${accountId}/ai/run/${CF_IMAGE_MODEL}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + apiToken },
        body: JSON.stringify({
          prompt: String(prompt).slice(0, 2048),
          seed: Math.floor(Math.random() * 1e9),
          steps: 8
        })
      }
    );
    const rawText = await upstream.text();
    let json = {};
    try { json = JSON.parse(rawText); } catch (e) { /* Cloudflare trả về không phải JSON (vd trang 404 dạng HTML) */ }
    if (!upstream.ok || !json || json.success === false) {
      // Kèm thêm vài chi tiết chẩn đoán (độ dài accountId, model đang dùng, và nguyên văn phản hồi của Cloudflare
      // nếu không có errors[].message rõ ràng) để soi ra ngay nếu accountId/token bị dính khoảng trắng thừa hoặc sai.
      var errFromCf = json && json.errors && json.errors[0] && json.errors[0].message;
      var cfMsg = errFromCf || (rawText ? String(rawText).replace(/\s+/g, ' ').trim().slice(0, 200) : ('Lỗi HTTP ' + upstream.status));
      var diag = ' [chẩn đoán: accountId dài ' + accountId.length + ' ký tự, model=' + CF_IMAGE_MODEL + ', HTTP ' + upstream.status + ']';
      res.status(upstream.status || 502).json({ error: { message: 'Cloudflare trả về: ' + cfMsg + diag } });
      return;
    }
    const imageBase64 = json.result && json.result.image;
    if (!imageBase64) {
      res.status(502).json({ error: { message: 'Cloudflare không trả về ảnh (phản hồi thiếu trường result.image)' } });
      return;
    }
    res.status(200).json({ image: imageBase64 });
  } catch (err) {
    res.status(502).json({ error: { message: 'Không gọi được Cloudflare Workers AI: ' + (err && err.message) } });
  }
}
